# equipment — environment variables
#
# Nothing here is required. `pnpm dev` runs the whole app (UI, API, sample
# data, sign-in as the users of seed-data/dev-users.json) with no settings at all. This file only lists
# what you MAY set; copy it to .env (never committed) for local overrides.

# --- Business day ---
# Time zone for "today" (default issue / return dates, overdue checks).
# APP_TIME_ZONE=Asia/Tokyo

# --- Sample data (local development only) ---
# `pnpm dev` loads the sample ledger into an empty local database
# (LOCAL_SAMPLE_DATA=1 by default). Set to 0 to start empty. A deployed app and
# `pnpm start` never load samples, whatever this says.
# LOCAL_SAMPLE_DATA=0

# --- libSQL database ---
# Injected by the platform (db.mode: libsql). Leave unset locally: the app uses
# a local file (file:./local.db). LOCAL_DB_URL overrides that file. The schema
# comes from migrations/ (applied at start and by `node scripts/migrate.mjs`).
# KEELSON_DB_URL=
# KEELSON_DB_AUTH_TOKEN=
# LOCAL_DB_URL=file:./local.db

# --- Workspace directory (employee list) ---
# Injected by the platform after `keelson apps directory enable` + redeploy.
# Do not set these by hand in production. Locally `keelson dev serve` injects
# its mock (or, without the CLI, the SDK's local mode reads the roster).
# KEELSON_DIRECTORY_BASE_URL=
# KEELSON_DIRECTORY_TOKEN=

# --- Attachments ---
# Production stores attachments in the platform file store (injected).
# Locally they go to KEELSON_FILES_DIR (the dev launcher uses .keelson/files).
# KEELSON_FILES_DIR=./.keelson/files

# --- Server (pnpm start) ---
# Port for `pnpm start` (the platform always uses 8080). Request body limit for
# attachments (keelson.yaml sets the same value for deploys).
# PORT=3000
# BODY_SIZE_LIMIT=11M
